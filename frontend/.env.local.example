# Optional: set only when the UI should call the backend directly (e.g. Vercel → Vercel backend).
# Leave UNSET during local `next dev` to use the built-in proxy: browser → /api/* → FastAPI (127.0.0.1:8000).
# NEXT_PUBLIC_API_URL=https://your-api.vercel.app

# Vercel production: the /api proxy rewrites to the backend project when this is set.
# Works for either backend host: Vercel (…vercel.app) or Railway (…up.railway.app).
# BACKEND_API_URL=https://your-api.vercel.app

# Override backend target for the dev proxy (default: http://127.0.0.1:8000)
# BACKEND_PROXY_URL=http://127.0.0.1:8000

# If every route is still 404 in dev, copy these lines to .env.local (overrides .env.development):
# WATCHPACK_POLLING=true
# CHOKIDAR_USEPOLLING=true
# And run: ulimit -n 10240