# Database — PostgreSQL required (Neon, Railway Postgres, Supabase, etc.)
# For local dev use `docker compose up -d` at the repo root, then set:
# DATABASE_URL=postgresql://workforce:workforce@127.0.0.1:5432/workforcepro
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/workforcepro

# JWT — REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=REDACTED_CHANGE_THIS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS — frontend URL allowed to make requests
FRONTEND_URL=http://localhost:3000
# For multiple Vercel previews, set a comma-separated list:
# FRONTEND_URLS=https://your-app.vercel.app,https://your-app-preview.vercel.app

# ── Platform notes ────────────────────────────────────────────────────────────
# Railway (long-lived container): leave SKIP_STARTUP_BOOTSTRAP unset or at "0" so
# startup migrations run; APScheduler reminders stay ENABLED (do not set the
# SHEET_REMINDER_SCHEDULER_ENABLED=false). Railway sets RAILWAY_ENV=production, which
# the app uses to require SECRET_KEY.
#
# Vercel (serverless): set SKIP_STARTUP_BOOTSTRAP=0 on the FIRST deploy to run the
# migration bootstrap, then set it to 1 (or remove it) for fast cold-starts.
# The scheduler is automatically disabled on serverless; configure a Vercel Cron job
# to POST /tasks/cron/reminders with a CRON_SECRET.
# SKIP_STARTUP_BOOTSTRAP=1
# CRON_SECRET=

# Optional: daily cron can POST /tasks/recurring/materialize with header X-Cron-Secret
CRON_SECRET=

# OpenAI (AI Assistant / chatbot)
OPENAI_API_KEY=REDACTED
OPENAI_API_KEY=

# Email automation
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USER=development.serphawk@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM_ADDRESS=development.serphawk@gmail.com
EMAIL_SUPPORT_ADDRESS=development.serphawk@gmail.com
SHEET_REMINDER_SCHEDULER_ENABLED=true
SHEET_REMINDER_TIME=21:00
SHEET_REMINDER_TIMEZONE=Asia/Kolkata
# Optional strict manual override format. Unmapped names do not receive email.
# EMPLOYEE_EMAIL_MAP={"employee name":"employee@example.com"}
EMPLOYEE_EMAIL_MAP=
