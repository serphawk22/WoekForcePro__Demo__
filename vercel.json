{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "true",
  "installCommand": "npm install --ignore-scripts",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/tasks/recurring/materialize",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/tasks/cron/reminders",
      "schedule": "0 9 * * *"
    }
  ]
}